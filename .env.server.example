# Never use an EXPO_PUBLIC_ prefix for secrets.
TRIPJACK_API_KEY=
TRIPJACK_ENV=sandbox
TRIPJACK_FLIGHT_BASE_URL=https://apitest.tripjack.com
TRIPJACK_HOTEL_BASE_URL=https://apitest-hms.tripjack.com
TRIPJACK_HOTEL_BOOKING_BASE_URL=https://apitest-hotel-booker.tripjack.com
PORT=4000
ALLOWED_ORIGINS=http://localhost:8085,http://127.0.0.1:8085
DATABASE_PATH=./data/travel.sqlite
# Provider booking writes are disabled until UAT/account readiness is verified.
ALLOW_PROVIDER_BOOKINGS=false
ALLOW_LIVE_BOOKINGS=false

# Server-only PayU Hosted Checkout credentials. Never use EXPO_PUBLIC_ names.
PAYU_MERCHANT_KEY=
PAYU_SALT=
PAYU_ENV=test
PUBLIC_API_URL=http://localhost:4000
