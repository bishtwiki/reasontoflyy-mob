{
  "expo": {
    "name": "Reason to Flyy",
    "slug": "reasontoflyy",
    "owner": "wiki_99",
    "version": "1.0.0",
    "icon": "./assets/brand/app-icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "reasontoflyy",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.reasontoflyy.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.reasontoflyy.app",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "backgroundColor": "#17283A"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "name": "Reason to Flyy",
      "shortName": "Reason to Flyy"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      "expo-status-bar",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Reason to Flyy to find hotels near your current location."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "922648c1-6a90-41bc-a1ab-63c44d15ab39"
      }
    }
  }
}
