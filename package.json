{
  "name": "easemytrip-clone",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web --port 8085",
    "server": "tsx watch server/index.ts",
    "dev": "concurrently -k -n api,app \"npm run server\" \"npm run web\"",
    "eas-build-pre-install": "node scripts/mobile-release-preflight.mjs",
    "build:android:apk": "eas build --platform android --profile preview",
    "build:android:store": "eas build --platform android --profile production",
    "build:ios:store": "eas build --platform ios --profile production",
    "submit:android": "eas submit --platform android --profile production",
    "submit:ios": "eas submit --platform ios --profile production",
    "typecheck": "tsc --noEmit && tsc -p server/tsconfig.json --noEmit",
    "test": "tsx --test server/tests/*.test.ts",
    "build:web": "expo export --platform web",
    "check:provider": "tsx scripts/check-provider.ts"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "expo": "~57.0.31",
    "expo-asset": "~57.0.20",
    "expo-font": "~57.0.4",
    "expo-linear-gradient": "~57.0.2",
    "expo-location": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "htmlparser2": "^12.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.4",
    "react-native-webview": "13.16.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^22.19.0",
    "@types/react": "~19.2.4",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.1",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=22.23.0"
  }
}
